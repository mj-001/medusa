# ── Medusa ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa
POSTGRES_PASSWORD=medusa

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
# Patterns Medusa subscribes to from RabbitMQ (comma-separated)
RABBITMQ_INBOUND_PATTERNS=delivery.*,payment.*,inventory.*

# ── ERPNext ───────────────────────────────────────────────────────────────────
ERPNEXT_VERSION=v15
ERPNEXT_SITE=erp.localhost
ERPNEXT_ADMIN_PASSWORD=admin
MARIADB_ROOT_PASSWORD=admin

# ERPNext API credentials (generate in ERPNext: Settings → API Access)
ERPNEXT_URL=http://localhost:8080
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# ── ERP Connector ─────────────────────────────────────────────────────────────
ERP_WEBHOOK_PORT=4001
